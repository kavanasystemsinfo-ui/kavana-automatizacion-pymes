# Copia este archivo a .env (chmod 600). scripts/deploy.sh lo crea solo la primera vez.
# Clave con la que n8n cifra las credenciales guardadas. Si se pierde, las credenciales no se pueden leer.
N8N_ENCRYPTION_KEY=

# Hasta publicar el formulario (F4) n8n trabaja en local.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
