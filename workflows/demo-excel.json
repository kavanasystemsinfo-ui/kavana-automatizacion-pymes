      "parameters": {
        "jsCode": "// Valida la petición de descarga: sesión del visitante y qué hoja quiere.\nconst q = $('Descargar Excel').first().json.query ?? {};\nconst sid = String(q.sid ?? '');\nif (!/^[a-f0-9]{32}$/.test(sid)) return [{ json: { ok: false, status: 400, error: 'Identificador de sesión no válido' } }];\nif (!['turnos', 'ausencias'].includes(q.hoja)) return [{ json: { ok: false, status: 400, error: 'Hoja no válida' } }];\nreturn [{ json: { ok: true, sid, hoja: q.hoja } }];\n"
      },
