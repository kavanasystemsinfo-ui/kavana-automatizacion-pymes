    {
      "id": "12428b0a-ff70-4f5d-b980-ba119fe14767",
      "name": "Generar plantilla RRHH",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        380
      ],
      "parameters": {
        "jsCode": "\n// Solicitudes de compañeros inventados, con fechas relativas a hoy y siempre las mismas para un mismo día.\n// Son comunes a todos los visitantes y de solo lectura. Ninguno es un empleado que el visitante pueda elegir.\nconst FESTIVOS = ['01-01', '01-06', '05-01', '08-15', '10-12', '11-01', '12-06', '12-08', '12-25'];\nconst VIERNES_SANTO = ['2026-04-03', '2027-03-26'];\nconst laborable = (d) => d.weekday < 6 && !FESTIVOS.includes(d.toFormat('MM-dd')) && !VIERNES_SANTO.includes(d.toFormat('yyyy-MM-dd'));\nconst contar = (a, z) => { let n = 0; for (let d = a; d <= z; d = d.plus({ days: 1 })) if (laborable(d)) n++; return n; };\n\n// El lunes de la semana que viene no, la siguiente: la página propone por defecto unas fechas que coinciden con Iván Ruiz.\nconst hoy = $now.setZone('Europe/Madrid').startOf('day');\nconst base = hoy.plus({ days: (8 - hoy.weekday) + 7 });\nconst PLANTILLA = [\n  // empleado, departamento, tipo, estado, días desde la base (inicio, fin), pedida hace N días, saldo previo\n  ['Raúl Peña', 'Producción', 'Asuntos propios', 'Aprobada', -14, -14, 12, 18],\n  ['Iván Ruiz', 'Producción', 'Vacaciones', 'Aprobada', 0, 4, 9, 22],\n  ['Andrés Gil', 'Comercial', 'Permiso retribuido', 'Pendiente', 1, 1, 1, 15],\n  ['Lucía Prieto', 'Administración', 'Vacaciones', 'Rechazada', 2, 6, 6, 20],\n  ['Carmen Vidal', 'Administración', 'Asuntos propios', 'Pendiente', 3, 3, 2, 17],\n  ['Sergio Mata', 'Logística', 'Vacaciones', 'Aprobada', 7, 11, 8, 22],\n  ['Elena Martín', 'Calidad', 'Vacaciones', 'Aprobada', 14, 18, 5, 19],\n  ['Óscar Lara', 'Logística', 'Vacaciones', 'Pendiente', 21, 25, 0, 22],\n];\nconst filas = PLANTILLA.map(([empleado, departamento, tipo, estado, a, z, hace, saldo], i) => {\n  const desde = base.plus({ days: a });\n  const hasta = base.plus({ days: z });\n  const pedida = hoy.minus({ days: hace }).set({ hour: 8 + i, minute: (i * 17) % 60 });\n  return {\n    sid: 'demo', fecha_solicitud: pedida.toFormat('yyyy-MM-dd HH:mm'), empleado, departamento, tipo,\n    desde: desde.toFormat('yyyy-MM-dd'), hasta: hasta.toFormat('yyyy-MM-dd'), dias: contar(desde, hasta),\n    saldo_previo: saldo, estado, comentario: '', conflictos: '',\n    decidido_en: estado === 'Pendiente' ? '' : pedida.plus({ hours: 26 }).toFormat('yyyy-MM-dd HH:mm'),\n    creado_ms: 0,\n  };\n}).filter((r) => r.dias > 0);\n// Coincidencias con el resto del departamento, como las calcularía el flujo real.\nfor (const r of filas) {\n  r.conflictos = filas\n    .filter((o) => o !== r && o.departamento === r.departamento && o.estado !== 'Rechazada' && o.desde <= r.hasta && o.hasta >= r.desde)\n    .map((o) => `${o.empleado} (${o.desde} a ${o.hasta}, ${o.estado.toLowerCase()})`)\n    .join('; ');\n}\nreturn filas.map((json) => ({ json }));\n"
      },
      "executeOnce": true
    },
