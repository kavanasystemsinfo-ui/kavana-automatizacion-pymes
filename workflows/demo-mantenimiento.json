    {
      "id": "fcf7532a-1e3a-5266-9a25-9f8efda56914",
      "name": "Generar semilla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        380
      ],
      "parameters": {
        "jsCode": "\n// Un mes de informes inventados (de hace 30 días a ayer), siempre iguales para una misma fecha.\nconst rng = (semilla) => () => {\n  semilla = (semilla + 0x6D2B79F5) | 0;\n  let t = Math.imul(semilla ^ (semilla >>> 15), 1 | semilla);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n};\nconst hoy = $now.setZone('Europe/Madrid').startOf('day');\nconst LINEAS = [\n  { n: 'Perfiladora 1', obj: 5000, ops: ['Marta Soler', 'Iván Ruiz', 'Carlos Vidal'], formato: 0.25 },\n  { n: 'Perfiladora 2', obj: 4000, ops: ['Laura Gómez', 'Raúl Peña', 'Sergio Mata'], formato: 0.5 },\n  { n: 'Cizalla', obj: 4000, ops: ['Nuria Ferrer', 'Hugo Ortiz', 'Pablo Cano'], formato: 0.15 },\n];\nconst TURNOS = [['Mañana', 14], ['Tarde', 22], ['Noche', 6]];\nconst entre = (r, a, b) => Math.round(a + r() * (b - a));\nconst OBS = {\n  'Avería': ['Avería en el motor principal; avisado mantenimiento.', 'Rodamiento del rodillo caliente; se cambia en el siguiente paro.', 'Fallo de sensor de final de carrera.'],\n  'Cambio de formato': ['Dos cambios de formato por pedidos pequeños.', 'Cambio de formato más largo de lo previsto.'],\n  'Falta de material': ['Llegó tarde la bobina del pedido urgente.', 'Se acabó la bobina y hubo que esperar la siguiente.'],\n  'Otros': ['Parada breve por limpieza de la línea.', 'Reunión de seguridad al inicio del turno.'],\n};\n\nconst filas = [];\nfor (let dia = 30; dia >= 1; dia--) {\n  const dt = hoy.minus({ days: dia });\n  if (dt.weekday === 7) continue;\n  LINEAS.forEach((l, li) => {\n    TURNOS.forEach(([turno, horaFin], ti) => {\n      if (dt.weekday === 6 && turno === 'Noche') return;\n      const r = rng(dia * 977 + li * 131 + ti * 17 + 12345);\n      // Historia: una racha de averías en la cizalla de noche y de tarde hace dos semanas.\n      const racha = l.n === 'Cizalla' && dia >= 12 && dia <= 16 && turno !== 'Mañana';\n      const averia = racha ? entre(r, 55, 110) : (r() < 0.12 ? entre(r, 15, 50) : 0);\n      const formato = r() < l.formato ? entre(r, 12, 40) : 0;\n      const material = r() < (turno === 'Tarde' ? 0.16 : 0.08) ? entre(r, 10, 40) : 0;\n      const otros = r() < 0.15 ? entre(r, 5, 20) : 0;\n      const total = averia + formato + material + otros;\n      let metros = Math.round(l.obj * (1 - (total / 480) * 1.6) * (0.9 + r() * 0.1));\n      metros = Math.max(0, Math.min(metros, Math.round(l.obj * 1.03)));\n      const eficiencia = Math.round((metros / l.obj) * 1000) / 10;\n      const paradas = { 'Avería': averia, 'Cambio de formato': formato, 'Falta de material': material, 'Otros': otros };\n      const [motivo, minutos] = Object.entries(paradas).sort((a, b) => b[1] - a[1])[0];\n      const opciones = OBS[motivo];\n      filas.push({ json: {\n        sid: 'demo', fecha: dt.toFormat('yyyy-MM-dd'), turno, linea: l.n, operario: l.ops[ti],\n        metros, objetivo: l.obj, eficiencia,\n        parada_averia: averia, parada_cambio_formato: formato, parada_falta_material: material, parada_otros: otros,\n        paradas_total: total, motivo_principal: minutos > 0 ? motivo : 'Sin paradas',\n        aviso: eficiencia < 80,\n        observaciones: minutos >= 25 ? opciones[entre(r, 0, opciones.length - 1)] : '',\n        registrado_en: dt.set({ hour: horaFin, minute: entre(r, 0, 20) }).toISO(),\n        creado_ms: 0,\n      } });\n    });\n  });\n}\nreturn filas;\n"
      }
    },
