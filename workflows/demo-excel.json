    {
      "parameters": {
        "jsCode": "// Convierte las filas del visitante en las columnas del Excel, con cabeceras legibles.\n// Si no tiene filas, devuelve un error en vez de un Excel vacío.\nconst { sid, hoja } = $('Elegir hoja').first().json;\nconst COLUMNAS = {\n  turnos: [\n    ['Fecha', 'fecha'], ['Turno', 'turno'], ['Línea', 'linea'], ['Operario', 'operario'],\n    ['Metros', 'metros'], ['Objetivo (m)', 'objetivo'], ['Eficiencia (%)', 'eficiencia'],\n    ['Avería (min)', 'parada_averia'], ['Cambio de formato (min)', 'parada_cambio_formato'],\n    ['Falta de material (min)', 'parada_falta_material'], ['Otros (min)', 'parada_otros'],\n    ['Paradas totales (min)', 'paradas_total'], ['Motivo principal', 'motivo_principal'],\n    ['Aviso (< 80 %)', (r) => (r.aviso ? 'Sí' : 'No')], ['Observaciones', 'observaciones'],\n    ['Registrado', (r) => String(r.registrado_en ?? '').slice(0, 16).replace('T', ' ')],\n  ],\n  ausencias: [\n    ['Solicitada', 'fecha_solicitud'], ['Empleado', 'empleado'], ['Departamento', 'departamento'],\n    ['Tipo', 'tipo'], ['Desde', 'desde'], ['Hasta', 'hasta'], ['Días laborables', 'dias'],\n    ['Vacaciones antes (de 22)', 'saldo_previo'], ['Estado', 'estado'], ['Coincide con', 'conflictos'],\n    ['Comentario', 'comentario'], ['Decidida', 'decidido_en'],\n  ],\n}[hoja];\n\nconst filas = $input.all().map((i) => i.json)\n  .filter((r) => r.sid === sid)\n  .sort((a, b) => Number(a.creado_ms) - Number(b.creado_ms));\nif (!filas.length) return [{ json: { ok: false, status: 404, error: 'Aún no has enviado nada: no hay filas que descargar.' } }];\n\nreturn filas.map((r) => {\n  const o = {};\n  for (const [titulo, campo] of COLUMNAS) o[titulo] = typeof campo === 'function' ? campo(r) : (r[campo] ?? '');\n  return { json: o };\n});\n"
      },
