# Copia este archivo a .env (chmod 600). scripts/deploy.sh lo crea solo la primera vez.
# Clave con la que n8n cifra las credenciales guardadas. Si se pierde, las credenciales no se pueden leer.
N8N_ENCRYPTION_KEY=

# El editor trabaja en local (túnel SSH).
N8N_HOST=localhost
N8N_PROTOCOL=http

# Dirección pública del formulario. Sin publicar, usar http://localhost:5678/
N8N_WEBHOOK_URL=https://informe.kavanasystems.com/
